Big_Boss_PAT_Github=your_big_boss_pat_github_here
# ============================================================
# CHECK-PLAN-GENERATOR-AGENTS — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit .env with real credentials.
# ============================================================

# ── LLM API Keys (Gemini / Google) ──────────────────────────
# Add multiple keys for round-robin rotation (minimum 2 recommended)
GOOGLE_API_KEY=
GOOGLE_API_KEY1=
GOOGLE_API_KEY2=
GOOGLE_API_KEY3=

# ── LLM API Keys (Groq — optional fallback) ─────────────────
GROQ_API_KEY=
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=

# ── Check Plan Template ──────────────────────────────────────
CHECK_TEMPLATE=plans/check_plan_template.xlsx

# ── Paths (Docker-compatible absolute paths) ─────────────────
UPLOAD_DIR=/app/reglements
PLANS_DIR=/app/plans

# ── Upload size limit (bytes, default 50 MB) ─────────────────
MAX_UPLOAD_BYTES=52428800

# ── CORS (comma-separated, no trailing slash) ─────────────────
# Leave empty to allow localhost only.
# Example: https://app.cdgcapital.ma,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ── Spring Boot Backend (Java) ───────────────────────────────
MONGO_URI=mongodb://mongo:27017/cdgcapital
SECRET_KEY=REPLACE_WITH_SECURE_64_CHAR_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=120
ADMIN_EMAIL=admin@cdgcapital.ma
ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# ── Frontend (Next.js) ───────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CHECK_PLANNER_URL=http://localhost:8057
